      identity["identity"]
      households["households"]
      audit["audit log"]:::planned
    end
    subgraph modules["Modules"]
      finance["finance"]:::planned
    end
  end

  subgraph stores["5 · Storage"]
    direction LR
    postgres[("PostgreSQL")]
    redis[("Redis")]
  end

  cli["Admin CLI<br/>family-hub"]

  request --> middleware --> routers --> dependencies --> services --> stores
