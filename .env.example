# Copy to apps/api/.env for local development. Never commit a real .env.
FH_ENVIRONMENT=development
FH_DATABASE_URL=postgresql+asyncpg://family_hub:family_hub@localhost:5432/family_hub
FH_REDIS_URL=redis://localhost:6379/0
# Local dev runs over plain HTTP, so cookies cannot be Secure. Never false in production.
FH_COOKIE_SECURE=false
# Production: set FH_SECRET_KEY to at least 32 random characters, e.g.
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
